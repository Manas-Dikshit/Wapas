# Wapas frontend runs fully on mock data with zero configuration — these are
# only needed once you wire up a real Supabase backend (see docs/SUPABASE.md).

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only, never exposed to the browser. Required only for admin scripts
# / service-role operations (e.g. seeding, bypassing RLS from a trusted server).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
